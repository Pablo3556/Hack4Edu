# Copiar a .env y cambiar las contraseñas. .env no se sube a Git.
# Evita en las contraseñas los caracteres @ : / ? # % (se usan en una URL de conexión).
POSTGRES_PASSWORD=cambia-superusuario
ESCUELA_ADMIN_PASSWORD=cambia-admin
APP_LECTOR_PASSWORD=cambia-lector
APP_INGESTA_PASSWORD=cambia-ingesta

# Usuarios de la app (importación de CSV, medidas). Cambiadlas fuera de la demo.
DOCENTE_PASSWORD=cambia-docente
DIRECCION_PASSWORD=cambia-direccion
ADMINISTRACION_PASSWORD=cambia-administracion

# ---- Opcionales (valores por defecto) ----
# Centro y grupo de cada usuario: el servidor rechaza cualquier consulta fuera de ellos.
# DIRECCION_CENTRO=1
# DOCENTE_CENTRO=1
# DOCENTE_GRUPO=1

# Clave de la cookie de sesión (16+ caracteres). Sin ella, reiniciar la app cierra las sesiones.
# SESION_CLAVE=

# Puertos publicados en este equipo
# APP_PUERTO=8080
# DB_PUERTO=5432

# Cargar el dataset de demostración y reindexar el asistente si la base está vacía
# CARGAR_DATOS=true

# Ollama del equipo (no va dentro del contenedor)
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_CHAT_MODEL=llama3.2:3b
# OLLAMA_MODELO_RAPIDO=llama3.2:1b
# OLLAMA_MODELO_PRECISO=qwen3.5:4b
# OLLAMA_EMBEDDING_MODEL=embeddinggemma
# RAG_EMBEDDING_DIM=768
